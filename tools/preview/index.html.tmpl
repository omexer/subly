<!doctype html>
<html>
<head>
<meta charset="utf-8">
<title>EasySubscription admin preview</title>
<link rel="stylesheet" href="css/buttons.min.css">
<link rel="stylesheet" href="css/common.min.css">
<link rel="stylesheet" href="css/forms.min.css">
<link rel="stylesheet" href="css/admin.css">
<link rel="stylesheet" href="preview.css">
<style>html,body{margin:0}body{background:#f6f7fb;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif}#wpcontent{margin:0;padding:0}.easysubscription-shell__bar{top:0}</style>
</head>
<body class="wp-admin easysubscription-admin">
<div id="wpwrap"><div id="wpcontent"><div id="wpbody-content">
<div class="easysubscription-shell">
	<header class="easysubscription-shell__bar"><div class="easysubscription-shell__inner">
		<nav class="easysubscription-crumbs"><a class="easysubscription-crumbs__home" href="#dashboard">{{MARK}}<span>EasySubscription</span></a><span class="easysubscription-crumbs__sep">/</span><span class="easysubscription-crumbs__current">Home</span></nav>
		<div class="easysubscription-shell__meta"><a href="#">Help</a><a href="#">Settings</a></div>
	</div></header>
	<div class="wrap easysubscription-shell__body">
		<div class="easysubscription-head"><div class="easysubscription-head__text"><h1 class="easysubscription-head__title"></h1><p class="easysubscription-head__subtitle"></p></div></div>
		<div id="screen" class="easysubscription-ui"></div>
	</div>
	<footer class="easysubscription-shell__foot">EasySubscription {{VERSION}} · <a href="#">Help and system report</a></footer>
</div>
</div></div></div>
<script src="preview.js"></script>
</body>
</html>
