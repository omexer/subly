<!doctype html>
<html>
<head>
<meta charset="utf-8">
<title>Subly admin preview</title>
<link rel="stylesheet" href="css/buttons.min.css">
<link rel="stylesheet" href="css/common.min.css">
<link rel="stylesheet" href="css/forms.min.css">
<link rel="stylesheet" href="css/admin.css">
<link rel="stylesheet" href="preview.css">
<style>html,body{margin:0}body{background:#f6f7fb;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif}#wpcontent{margin:0;padding:0}.subly-shell__bar{top:0}</style>
</head>
<body class="wp-admin subly-admin">
<div id="wpwrap"><div id="wpcontent"><div id="wpbody-content">
<div class="subly-shell">
	<header class="subly-shell__bar"><div class="subly-shell__inner">
		<nav class="subly-crumbs"><a class="subly-crumbs__home" href="#dashboard">{{MARK}}<span>Subly</span></a><span class="subly-crumbs__sep">/</span><span class="subly-crumbs__current">Home</span></nav>
		<div class="subly-shell__meta"><a href="#">Help</a><a href="#">Settings</a></div>
	</div></header>
	<div class="wrap subly-shell__body">
		<div class="subly-head"><div class="subly-head__text"><h1 class="subly-head__title"></h1><p class="subly-head__subtitle"></p></div></div>
		<div id="screen" class="subly-ui"></div>
	</div>
	<footer class="subly-shell__foot">Subly {{VERSION}} · <a href="#">Help and system report</a></footer>
</div>
</div></div></div>
<script src="preview.js"></script>
